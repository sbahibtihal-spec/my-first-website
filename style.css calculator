* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #0d1117, #161b22);
}

.calculator {
    width: 320px;
    padding: 20px;
    background: #222831;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
}

#display {
    width: 100%;
    height: 70px;
    margin-bottom: 15px;
    padding: 10px;
    border: none;
    border-radius: 12px;
    background: #111820;
    color: white;
    font-size: 30px;
    text-align: right;
}

.buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
}

button {
    height: 60px;
    border: none;
    border-radius: 12px;
    background: #393e46;
    color: white;
    font-size: 20px;
    cursor: pointer;
    transition: 0.2s;
}

button:hover {
    transform: scale(1.05);
    background: #4b5260;
}

button:active {
    transform: scale(0.95);
}

.zero {
    grid-column: span 2;
}

.equal {
    background: #0077ff;
}

.equal:hover {
    background: #005dcc;
}
